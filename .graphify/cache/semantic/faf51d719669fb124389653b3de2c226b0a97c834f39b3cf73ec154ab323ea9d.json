{"nodes":[{"id":"readme_hm_architect","label":"HM Architect — Tangier (studio site)","file_type":"document","source_file":"README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Cinematic portfolio site for an architecture and interiors studio working between Tangier, Tétouan and Brussels."},{"id":"readme_index_page","label":"Home Page (index.html route)","file_type":"document","source_file":"README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null},{"id":"readme_project_page","label":"Project Page (project.html?p=<slug> route)","file_type":"document","source_file":"README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null},{"id":"readme_projects_data","label":"src/data/projects.js","file_type":"document","source_file":"README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null},{"id":"readme_placeholder_seed","label":"PLACEHOLDER_SEED","file_type":"document","source_file":"README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Generates five more placeholder entries per category (24 total) so the slider and filters have content to lay out against; borrows real projects' imagery, rotated so no two cards open on the same plate. Flagged placeholder:true and nothing else refers to them, so removable by deleting PLACEHOLDER_SEED and the ...placeholders spread."},{"id":"readme_process_images_script","label":"tools/process-images.sh","file_type":"document","source_file":"README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Processes Instagram screenshot source images offline: removes carousel chrome via ffmpeg's delogo filter (rather than cropping, to preserve full ~850px frame), applies a light grade, and outputs two sizes per plate (native NN.webp and upscaled NN-lg.webp)."},{"id":"readme_loader_js","label":"src/js/loader.js","file_type":"document","source_file":"README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Shuffles a small plate through the portfolio as images decode, tracks real progress via a counter, then flies the plate to full bleed as the headline wipes up word by word."},{"id":"readme_hero_js","label":"src/js/hero.js","file_type":"document","source_file":"README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Only decides when to cut between four cross-cutting full-bleed plates; the Ken Burns drift itself lives in CSS so a class toggle restarts it."},{"id":"readme_mark_js","label":"src/js/mark.js","file_type":"document","source_file":"README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Fetches and inlines hma-mark.svg so the monogram's own contour can be lifted via <use> and stroked; draws the contour with a dash offset like a drawing-board reveal, then floods fill and retires the contour. Falls back to a fading raster if the fetch never lands."},{"id":"readme_hma_mark_svg","label":"hma-mark.svg (traced mark)","file_type":"document","source_file":"README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Traced in two passes because the artwork mixes a solid two-tone monogram with a half-pixel hairline subline at partial alpha."},{"id":"readme_work_js","label":"src/js/work.js","file_type":"document","source_file":"README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Card-deck slider in CSS 3D perspective. Position is a float eased by a lerp loop rather than an index. layout() owns every card's transform/opacity/z-index exclusively."},{"id":"readme_home_css","label":"src/css/home.css","file_type":"document","source_file":"README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null},{"id":"readme_base_css","label":"src/css/base.css","file_type":"document","source_file":"README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Holds colour/type tokens: white ground with burgundy reserved for numbered labels, badges, the SEE WORK line, hover/focus states, and the menu overlay/cookie notice surfaces."},{"id":"readme_contact_js","label":"src/js/contact.js","file_type":"document","source_file":"README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Validation is real; submission is not — send() needs to be replaced with a POST to a real endpoint before going live."},{"id":"readme_favicon_svg","label":"public/favicon.svg","file_type":"document","source_file":"README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Same monogram on a burgundy disc, needing a ground and extra optical weight since a plain reduction's hairlines vanish at tab size."},{"id":"readme_trace_mark_script","label":"npm run trace:mark","file_type":"document","source_file":"README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Regenerates hma-mark.svg (and the favicon) from the master PNG, tracing the monogram and subline at different thresholds."},{"id":"readme_hma_monogram_svg","label":"hma-monogram.svg","file_type":"document","source_file":"README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Header runs the monogram alone rather than the full lockup because under ~120px the subline becomes an unreadable grey smear. White artwork so it works with the header's difference blend."},{"id":"readme_hma_original_jpg","label":"hma-original.jpg","file_type":"document","source_file":"README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"The supplied artwork, untouched, on its burgundy plate."},{"id":"readme_hma_mark_png","label":"hma-mark.png","file_type":"document","source_file":"README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Mark lifted off the burgundy plate by luminance keying: threshold at 88 removes the plate cleanly and RGB is forced white to avoid burgundy fringing."},{"id":"readme_hma_mark_webp","label":"hma-mark.webp","file_type":"document","source_file":"README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"7kB fallback image used if the SVG fetch never arrives."},{"id":"readme_founder_portrait_jpg","label":"haytham-mribah.jpg (founder portrait)","file_type":"document","source_file":"README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Fixed 4:5 box with object-fit: cover so a differently-shaped replacement needs no manual crop."},{"id":"readme_icon_stroke","label":"ICON_STROKE","file_type":"document","source_file":"README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Extra weight added to the favicon mark in the mark's own units — the optical sizing a type designer applies for small text."},{"id":"readme_raf_js","label":"src/js/raf.js","file_type":"document","source_file":"README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Races requestAnimationFrame against a timer so the loader doesn't stall in a suspended background tab."},{"id":"readme_vite","label":"Vite","file_type":"document","source_file":"README.md","source_location":null,"source_url":nu